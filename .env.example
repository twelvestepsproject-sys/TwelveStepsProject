# --- always ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATA_SOURCE=mock                 # mock | supabase | postgres  ← the swap switch (§5.5)

# --- mock phase only ---
MOCK_LATENCY_MS=150
MOCK_ERROR_RATE=0

# --- Phase 5: Supabase ---
# Required when DATA_SOURCE=supabase. lib/supabase/server.ts (RLS-scoped
# client) and lib/queries/supabase/* use the first two; SUPABASE_SERVICE_ROLE_KEY
# is used ONLY by lib/supabase/admin.ts and the one-off scripts under
# /scripts and /supabase/seed, /supabase/tests — never client-side, never
# for a normal request path. Server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Not yet wired up in this codebase — uncomment and implement when the
# corresponding feature is built (§13 lists these as eventual Phase 5+
# needs, but nothing currently reads them, so they stay commented per
# "commit .env.example, never real values" / don't document unused vars) ---
# REVALIDATE_SECRET=
# PREVIEW_SECRET=
# RESEND_API_KEY=
# NOTIFICATION_EMAIL_TO=
# NEXT_PUBLIC_GTM_ID=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Required when DATA_SOURCE=postgres (self-hosted, no Supabase at runtime).
# ---------------------------------------------------------------------------

# The Postgres connection. Locally this is the docker-compose service;
# in production point it at the server's own instance.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/twelvesteps

# Signs the admin session cookie (lib/auth/session.ts). Must be at least 32
# characters, and MUST differ per environment — anyone holding this value can
# forge an admin session. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it simply signs everyone out; it is not a data-loss risk.
SESSION_SECRET=

# Where uploaded media lives on disk (lib/storage/paths.ts). Defaults to
# ./storage/media. On the server set this to a path on a persistent volume
# OUTSIDE the deploy directory, or a redeploy will delete every upload.
# STORAGE_DIR=/var/lib/twelvesteps/media

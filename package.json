{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:schema": "echo \"[typecheck:schema] no-op until Phase 5 generates DB types from Supabase — will assert generated types are assignable to /lib/schemas domain types\" && exit 0",
    "check:placeholder": "node scripts/check-placeholder.mjs",
    "check:blocks": "tsx scripts/check-page-blocks.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "mock:reset": "node scripts/mock-reset.mjs",
    "supabase:seed": "tsx supabase/seed/seed.mjs",
    "supabase:create-first-admin": "tsx scripts/create-first-admin.mjs",
    "supabase:rls-proof": "tsx supabase/tests/rls-anon-proof.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d && node scripts/wait-for-db.mjs && node scripts/pg-migrate.mjs",
    "db:migrate": "node scripts/pg-migrate.mjs",
    "db:import": "node scripts/pg-import-content.mjs && node scripts/pg-import-storage.mjs",
    "db:psql": "docker exec -it twelvesteps-postgres psql -U postgres -d twelvesteps",
    "setup:local": "node scripts/setup-local.mjs",
    "db:set-password": "node scripts/pg-set-password.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "next": "16.2.10",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}

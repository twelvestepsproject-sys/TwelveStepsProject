# Production configuration for the Contabo VPS.
#
# Copy to `.env` on the server and fill in every value:
#     cp .env.production.example .env
#     nano .env
#
# This file is a template and is committed. The `.env` you create from it
# holds real secrets and is gitignored — never commit that one.

# ---------------------------------------------------------------------------
# Domain
# ---------------------------------------------------------------------------

# Full public URL, no trailing slash. Used for canonical links, the
# sitemap and RSS, so a wrong value here shows up in Google.
NEXT_PUBLIC_SITE_URL=https://example.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

POSTGRES_USER=twelvesteps
POSTGRES_DB=twelvesteps

# Generate, do not invent:
#   openssl rand -base64 32
# The database is not reachable from the internet, but a weak password
# still matters — it is the last barrier if anything else is breached.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------

# Signs the admin session cookie. At least 32 characters, and different
# from any other environment. Anyone holding this value can forge an admin
# session, so treat it like a password:
#   openssl rand -hex 32
# Changing it signs everyone out. That is the whole effect — no data loss.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------

# Host directory that gets mounted into the container. It MUST live
# outside the deploy directory: if uploads sit inside the folder you
# redeploy, the next deploy deletes everything the client uploaded.
STORAGE_DIR_HOST=/var/lib/twelvesteps/media

# ---------------------------------------------------------------------------
# One-time migration from Supabase (optional)
# ---------------------------------------------------------------------------
#
# Only needed if you are importing existing content on the server rather
# than restoring a dump taken locally. Delete both lines afterwards — the
# service-role key bypasses every access rule and should not sit on a
# server longer than the import takes.
#
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

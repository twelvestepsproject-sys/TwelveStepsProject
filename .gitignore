# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# Template for the server's .env — placeholders only, no real values. The
# .env created from it on the server stays ignored by the rule above.
!.env.production.example

# mock write-store (Phase 4) — persisted CMS edits, never committed
.mock-db.json

# vercel
.vercel

# supabase CLI local cache — machine-local link/pooler metadata, never committed
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# Office temp/lock files
~$*

# Migrated media files — content, not source. Fetched with
# scripts/pg-import-storage.mjs and served from disk in self-hosted mode.
/storage/

# Database dumps taken for a deploy — content, sometimes large, and never
# something to version alongside the code. The glob matters as much as the
# two named files: a dump pulled from production to debug against carries
# real leads and contact details, and it is named for whatever the moment
# called for, not `dump`.
/dump.sql
/dump.sql.gz
*.sql.gz
*.tar.gz
/backups/

# This project uses pnpm. A stray npm lockfile would make the Dockerfile
# choose `npm ci` over `pnpm install --frozen-lockfile`.
package-lock.json

# nginx config snapshots taken by deploy/emet-vhost-up.sh before it edits
# anything. They live inside the stack directory so the rollback script can
# find them without configuration, which also puts them inside the repo on
# the server — hence this rule. The two pointer files record which snapshot
# and which docker network the last run used.
nginx/conf.d.bak.*
.emet-vhost-last-backup
.emet-vhost-last-network
